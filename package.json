{
  "name": "veildrive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first encrypted cloud storage and proof exchange on Midnight.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "zk:sync": "node scripts/sync-zk-assets.mjs",
    "dev": "pnpm --dir contract build && pnpm zk:sync && vite",
    "build": "pnpm --dir contract build && pnpm zk:sync && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && pnpm --dir contract test && pnpm --dir sdk test",
    "test:watch": "vitest",
    "lint": "eslint .",
    "contract:compile": "pnpm --dir contract compact",
    "contract:compile:wsl": "wsl bash ./scripts/compile-contract-wsl.sh",
    "contract:test": "pnpm --dir contract test",
    "proof-server": "node scripts/proof-server.mjs start",
    "proof-server:status": "node scripts/proof-server.mjs status",
    "proof-server:stop": "node scripts/proof-server.mjs stop",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@veildrive/contract": "workspace:*",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@phosphor-icons/react": "2.1.10",
    "buffer": "6.0.3",
    "process": "0.11.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "fake-indexeddb": "6.2.4",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.42.0",
    "vite": "8.3.0",
    "vite-plugin-node-polyfills": "0.28.0",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "4.1.11"
  }
}
